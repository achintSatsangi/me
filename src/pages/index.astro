---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const beliefs = [
  'No code is the best code. Simplicity is a prerequisite for reliability.',
  'Restraint over addition. Delete first, add only when it earns its cost.',
  'Warm about the person. Sharp about the work.',
  'Cross-cultural fluency is a technical skill.',
  'Questions are data. If someone in the room is asking "wait, why?", the room is safer, not slower.',
];

const knownFor = [
  'Cutting a messy problem down to the smallest thing that actually solves it.',
  'Holding the seam between teams when nobody else is watching it.',
  'Teaching the person next to me so they can do the thing without me.',
  'Writing the Slack post that ends the thread instead of extending it.',
];

---
<Layout title="Achint Satsangi">
  <section class="page hero" data-testid="hero-content">
    <p class="meta mb-6" data-testid="hero-eyebrow">Nordic Desi, Mumbaikar at heart · Oslo, Norway</p>
    <h1 class="display-xl" data-testid="hero-name">
      Achint&nbsp;Satsangi.
    </h1>
    <p class="mt-10 body-lg max-w-4xl text-muted dark:text-muted-dark" data-testid="hero-masthead">
      I translate messy engineering problems into small, quiet solutions —
      and I write down what I learn on the way.
    </p>

    <div class="mt-16 flex flex-wrap gap-4" data-testid="hero-doors">
      <a href={`${base}/journey/`} class="pill">Journey</a>
      <a href={`${base}/feed/`} class="pill">Feed</a>
      <a href={`${base}/articles/`} class="pill">Articles</a>
    </div>

    <p class="meta mt-10 opacity-70 max-w-3xl" data-testid="hero-whofor">
      Nineteen years in code. Mumbai → Johannesburg → Oslo. Currently a senior
      engineer on FINN’s messaging platform, working toward Staff.
    </p>
  </section>

  <section class="page section" data-testid="hero-photo-section">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-center">
      <div class="md:col-span-5" data-testid="hero-photo">
        <div class="aspect-[4/5] w-full bg-rule dark:bg-rule-dark rounded-2xl overflow-hidden flex items-center justify-center">
          <div class="text-center text-muted dark:text-muted-dark p-8">
            <div class="font-display text-5xl mb-2 opacity-40 font-semibold">AS</div>
            <div class="meta opacity-60">unposed candid — TBD</div>
          </div>
        </div>
      </div>
      <div class="md:col-span-7" data-testid="hero-intro-block">
        <h2 class="display-md mb-8">A short version.</h2>
        <p class="body-lg text-muted dark:text-muted-dark max-w-prose" data-testid="hero-intro">
          Mumbaikar by birth, Nordic desi by choice. Started in Mumbai on Java web apps, shipped a
          rules engine at one of South Africa’s largest universities, landed in Oslo in 2014
          and stayed. I run toward the systems that need to be quiet under load — messaging,
          payments, the boring critical path. Teacher before I was an engineer; that habit
          hasn’t left.
        </p>
      </div>
    </div>
  </section>

  <section class="page section" data-testid="hero-known-for-section">
    <p class="meta mb-10">What I’m known for.</p>
    <ul class="space-y-5 max-w-3xl body-lg text-ink dark:text-ink-dark list-none" data-testid="hero-known-for">
      {knownFor.map((line) => (
        <li class="flex gap-4">
          <span class="text-muted dark:text-muted-dark opacity-50 select-none">—</span>
          <span>{line}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="page section" data-testid="hero-beliefs-section">
    <p class="meta mb-10">What I believe about work.</p>
    <div class="space-y-12 max-w-4xl" data-testid="hero-beliefs">
      {beliefs.map((line, i) => (
        <p class="text-2xl md:text-3xl leading-[1.35] text-ink dark:text-ink-dark font-display font-medium tracking-tight">
          <span class="text-muted dark:text-muted-dark mr-4 opacity-60">0{i + 1}</span>
          {line}
        </p>
      ))}
    </div>
  </section>

  <section class="page section" data-testid="hero-ai-section">
    <p class="meta mb-10">How I think about AI.</p>
    <div class="max-w-3xl space-y-6 body-lg text-muted dark:text-muted-dark" data-testid="hero-ai">
      <p>
        I’ve been building with LLMs since ChatGPT shipped in November 2022. Not learning —
        building. Customer-facing features in production. Daily use to lift my own and my team’s
        throughput. <a href={`${base}/articles/`} class="text-accent dark:text-accent-dark">A
        published argument</a> on how to regulate the layer above it.
      </p>
      <p>
        The position I hold: <span class="text-ink dark:text-ink-dark font-medium">“AI” is not a strategy.</span>
        <span class="text-ink dark:text-ink-dark font-medium">“AI for X, because Y, replacing what Z does today”</span>
        is a strategy. The first one bleeds money into surface solutions while the real problem keeps fighting you.
      </p>
      <p>
        What I want to work on next: the seam between domain experts and AI systems. Less preaching, less learning in public — more building. Real solutions that add value to <span class="text-ink dark:text-ink-dark font-medium">people I can name</span>: the users of the platforms I ship on, my peers at work, <span class="text-ink dark:text-ink-dark font-medium">my family and friends at home</span>.
      </p>
    </div>
  </section>

  <section class="page section" data-testid="hero-contact-section">
    <p class="meta mb-10">Get in touch.</p>
    <div class="max-w-3xl">
      <p class="display-md mb-10">
        If any of this makes you want to talk — a role, a partnership, a coffee in Oslo, or an
        argument about AI regulation — my inbox is open.
      </p>
      <div class="flex flex-wrap gap-x-10 gap-y-3 text-base md:text-lg" data-testid="hero-contact-links">
        <a href="mailto:achint.satsangi@gmail.com" class="text-accent dark:text-accent-dark">achint.satsangi@gmail.com</a>
        <a href="https://linkedin.com/in/achint-satsangi" class="text-accent dark:text-accent-dark">LinkedIn</a>
        <a href="https://github.com/achintSatsangi" class="text-accent dark:text-accent-dark">GitHub</a>
      </div>
    </div>
  </section>
</Layout>
