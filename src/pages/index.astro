---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const beliefs = [
  'No code is the best code. Simplicity is a prerequisite for reliability.',
  'Restraint over addition. Delete first, add only when it earns its cost.',
  'Warm about the person. Sharp about the work.',
  'Cross-cultural fluency is a technical skill.',
];
---
<Layout title="Achint Satsangi">
  <section class="page grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-16 items-center min-h-[80vh]">
    <div class="md:col-span-3 order-2 md:order-1" data-testid="hero-photo">
      <div class="aspect-[4/5] w-full bg-rule dark:bg-rule-dark rounded-sm overflow-hidden flex items-center justify-center">
        <div class="text-center text-muted dark:text-muted-dark p-8">
          <div class="font-serif text-3xl mb-2 opacity-40">AS</div>
          <div class="meta opacity-60">unposed candid — TBD</div>
        </div>
      </div>
    </div>

    <div class="md:col-span-2 order-1 md:order-2" data-testid="hero-content">
      <h1 class="display" data-testid="hero-name">Achint<br />Satsangi</h1>
      <p class="mt-6 font-serif text-lg md:text-xl italic text-muted dark:text-muted-dark leading-relaxed" data-testid="hero-masthead">
        Nordic Desi. Engineer in Oslo, writer from Agra. Father of two, runner, sketcher, delete-first.
      </p>

      <p class="mt-8 text-base md:text-lg leading-relaxed max-w-prose" data-testid="hero-intro">
        I grew up in Agra, learned to code in Mumbai, learned winters in Oslo. Nineteen years of building systems that
        need to be quiet under load. I write about AI, India, and the shape of good engineering. Most days you'll find
        me in a messaging codebase, on a trail behind the house, or halfway into a sketch.
      </p>

      <div class="mt-10 space-y-3" data-testid="hero-beliefs">
        {beliefs.map((line) => (
          <p class="font-serif text-base md:text-lg leading-snug">— {line}</p>
        ))}
      </div>

      <nav class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm" data-testid="hero-doors">
        <a href={`${base}/journey/`} class="nav-link">Journey&nbsp;→</a>
        <a href={`${base}/feed/`} class="nav-link">Feed&nbsp;→</a>
        <a href={`${base}/articles/`} class="nav-link">Articles&nbsp;→</a>
      </nav>
    </div>
  </section>
</Layout>
