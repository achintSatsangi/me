---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Page not found - Achint Satsangi">
  <section class="page hero-inner">
    <h1 class="display-lg max-w-5xl">Page not found.</h1>
    <p class="mt-10 body-lg"><a href={`${base}/`}>Back to the front page</a></p>
  </section>
</Layout>
