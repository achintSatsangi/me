---
import Layout from '../layouts/Layout.astro';
import journey from '../data/journey.json';
import recommendations from '../data/recommendations.json';
import github from '../data/github.json';

function formatDate(iso: string | null): string {
  if (!iso) return 'Present';
  const [y, m] = iso.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(m,10)-1]} ${y}`;
}
function formatRecDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
}

const featuredRecNames = [
  'Christian Kjendseth Wiik',
  'Marius Jakobsen',
  'Endre Midtgård Meckelborg',
  'Prashant Prakash',
];
const featuredRecs = featuredRecNames
  .map((name) => recommendations.find((r) => r.name === name))
  .filter(Boolean);
---
<Layout title="Journey — Achint Satsangi">
  <section class="page hero" data-testid="journey-hero-section">
    <p class="meta mb-6">The professional side</p>
    <h1 class="display-lg max-w-5xl" data-testid="journey-hero">
      Nineteen years of shipping. Ten of them in Oslo. Backend and platform work on systems
      that fail loudly if you get them wrong.
    </h1>
    <p class="mt-10 body-lg max-w-3xl text-muted dark:text-muted-dark">
      Mumbai → Johannesburg → Gurgaon → Oslo. Currently at Vend Marketplaces — the umbrella
      parent behind finn.no, blocket.se, tori.fi and dba.dk — on the messaging platform that
      all four brands run on.
    </p>
  </section>

  <section class="page section" data-testid="journey-timeline">
    {journey.map((role, idx) => (
      <article class={`max-w-5xl mx-auto py-16 ${idx === 0 ? '' : 'border-t border-rule dark:border-rule-dark'}`}>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
          <div class="md:col-span-3">
            {role.end === null && (
              <span class="inline-block mb-3 px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full bg-accent text-paper dark:bg-accent-dark dark:text-paper-dark">
                Current
              </span>
            )}
            <div class={`meta ${role.end === null ? 'text-base font-semibold text-ink dark:text-ink-dark' : ''}`} data-testid="role-dates">
              {formatDate(role.start)} — {formatDate(role.end)}
            </div>
            <div class="meta text-muted dark:text-muted-dark mt-1">{role.location}</div>
          </div>
          <div class="md:col-span-9 max-w-prose">
            <h3 class="display-md" data-testid="role-company">{role.company}</h3>
            <p class="meta mt-2" data-testid="role-title">{role.role}</p>
            <div class="mt-5 space-y-4" data-testid="role-summary">
              {role.summary.split('\n\n').map((para) => (
                <p class="body-lg text-muted dark:text-muted-dark hyphens-auto text-justify">{para}</p>
              ))}
            </div>
            {role.restricted && (
              <p class="meta mt-4 text-muted dark:text-muted-dark">
                Company privacy policy and code of conduct keep the specifics off this page — <a href="https://linkedin.com/in/achint-satsangi">LinkedIn</a> has what I can share publicly.
              </p>
            )}
            {role.projects && (
              <details class="group mt-6" data-testid="role-projects">
                <summary class="meta text-muted dark:text-muted-dark cursor-pointer list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-2 hover:text-ink dark:hover:text-ink-dark">
                  <span class="transition-transform group-open:rotate-90">▸</span>
                  <span class="group-open:hidden">The projects — {role.projects.reduce((n, g) => n + g.items.length, 0)} at {role.projects.map((g) => g.client).join(' and ')}</span>
                  <span class="hidden group-open:inline">Hide projects</span>
                </summary>
                <div class="mt-6 space-y-8">
                  {role.projects.map((group) => (
                    <div>
                      <div class="meta font-semibold text-ink dark:text-ink-dark mb-4">{group.client}</div>
                      <ul class="space-y-4 list-none">
                        {group.items.map((p) => (
                          <li class="border-l border-rule dark:border-rule-dark pl-5">
                            <div class="flex items-baseline gap-2 flex-wrap">
                              <span class="text-sm font-semibold text-ink dark:text-ink-dark">{p.name}</span>
                              <span class="meta text-muted dark:text-muted-dark">{p.role}</span>
                            </div>
                            <p class="mt-1 text-base leading-[1.5] text-muted dark:text-muted-dark">{p.blurb}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section id="recommendations" class="section max-w-[92rem] mx-auto px-6 md:px-10 border-t border-rule dark:border-rule-dark" data-testid="recommendations">
    <h2 class="meta mb-6">In their words</h2>
    <h3 class="display-lg max-w-4xl mb-16">
      Four people, four different rooms.
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredRecs.map((r) => (
        <blockquote
          class="relative bg-paper dark:bg-[#1A1A1D] border border-rule dark:border-rule-dark rounded-xl p-8 md:p-9 flex flex-col h-full"
          data-testid={`rec-${r.name.split(' ')[0].toLowerCase()}`}
        >
          <div class="absolute top-6 right-6 text-linkedin opacity-90" title="Recommendation on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2zM8 19H5v-9h3v9zM6.5 8.25A1.75 1.75 0 1 1 8.3 6.5a1.78 1.78 0 0 1-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0 0 13 14.19a.66.66 0 0 0 0 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 0 1 2.7-1.4c1.55 0 3.36.86 3.36 3.66z"/></svg>
          </div>
          <div class="flex-1">
            <div class="font-display text-6xl leading-none text-accent dark:text-accent-dark opacity-30 mb-2" aria-hidden="true">“</div>
            <p class="text-base md:text-lg leading-[1.55] text-ink dark:text-ink-dark hyphens-auto text-justify">{r.quote}</p>
          </div>
          <footer class="border-t border-rule dark:border-rule-dark pt-4 mt-6">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-linkedin/10 dark:bg-linkedin/20 flex items-center justify-center text-linkedin font-semibold text-sm shrink-0">
                {r.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-ink dark:text-ink-dark">{r.name}</div>
                <div class="text-xs text-muted dark:text-muted-dark line-clamp-2">{r.role} at {r.company}</div>
                <div class="text-xs text-muted dark:text-muted-dark mt-0.5">Recommendation received {formatRecDate(r.date)}</div>
              </div>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
    <p class="meta mt-10 text-muted dark:text-muted-dark">
      See all on <a href="https://linkedin.com/in/achint-satsangi/details/recommendations/" class="text-linkedin">LinkedIn →</a>
    </p>
  </section>

  <section class="page section border-t border-rule dark:border-rule-dark" data-testid="github-section">
    <h2 class="meta mb-8">On GitHub — <a href={github.profile.url} class="text-accent dark:text-accent-dark">@{github.profile.handle}</a></h2>
    <h3 class="display-md mb-14 max-w-3xl">
      Nineteen public repos. Some AI experiments, some workshop material, one hobby project
      I keep coming back to when I want to remember how React hooks work.
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 max-w-5xl">
      {github.selected.map((repo) => (
        <a href={repo.url} target="_blank" rel="noopener noreferrer" class="group block [background-image:none]">
          <div class="flex items-baseline justify-between gap-4 mb-2">
            <h3 class="text-lg md:text-xl font-display font-semibold tracking-tight text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
              {repo.name}
            </h3>
            {repo.language !== '-' && <span class="meta text-muted dark:text-muted-dark shrink-0">{repo.language}</span>}
          </div>
          <p class="text-base leading-[1.55] text-muted dark:text-muted-dark max-w-prose">{repo.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="page section border-t border-rule dark:border-rule-dark" data-testid="early-life-section">
    <h2 class="meta mb-8">Before the code.</h2>
    <div class="max-w-3xl space-y-6 body-lg text-muted dark:text-muted-dark border-l border-rule dark:border-rule-dark pl-8" data-testid="early-life">
      <p>
        Three years of diploma, then three of the engineering degree. The diploma built the practical fundamentals, so the degree came lighter — maths, analytical thinking, and engineering drawing already in hand. That left student life mostly for the field and the band: captain of the university and engineering-faculty volleyball teams, vice-captain in football and basketball, on the athletics podium most years, lead drummer of the university band for three years. Leading teams and keeping time for other people, long before I did either in a codebase.
      </p>
      <p class="meta">Dayalbagh Educational Institute · Agra · Diploma + engineering degree · 2001–2007</p>
    </div>
  </section>

  <section class="page section border-t border-rule dark:border-rule-dark" data-testid="journey-note-section">
    <h2 class="meta mb-8">A note on nineteen years.</h2>
    <div class="max-w-3xl space-y-6 body-lg text-muted dark:text-muted-dark border-l border-rule dark:border-rule-dark pl-8" data-testid="journey-note">
      <p>
        Some of this timeline was the work I wanted. Some of it was the work I had. A lot of it
        was 3am pages, migrations that ran longer than they should have, teams that outgrew each
        other, and the specific tiredness of shipping something you’re not sure anyone will use.
      </p>
      <p>
        I mention this because the timeline reads clean and the work rarely is. When we’re in
        a room together, that’s the room I show up in — the one that knows the difference.
      </p>
    </div>
  </section>
</Layout>
