---
import Layout from '../layouts/Layout.astro';
import journey from '../data/journey.json';
import recommendations from '../data/recommendations.json';

function formatDate(iso: string | null): string {
  if (!iso) return 'Present';
  const [y, m] = iso.split('-');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(m,10)-1]} ${y}`;
}
function formatRecDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---
<Layout title="Journey — Achint Satsangi">
  <section class="page">
    <p class="meta mb-4">The professional side</p>
    <h1 class="font-serif text-4xl md:text-6xl leading-tight font-medium max-w-prose" data-testid="journey-hero">
      Nineteen years of shipping, teaching, and translating complexity into clean solutions.
    </h1>
    <p class="mt-6 text-lg leading-relaxed max-w-prose text-muted dark:text-muted-dark">
      Backend + platform engineering. Started in Mumbai on Java web apps, moved to Johannesburg to build a rules
      engine for a large university, landed in Oslo in 2014 and stayed. Currently at Vend Marketplaces, leading
      the messaging platform behind four Nordic brands.
    </p>
  </section>

  <section class="page pt-0" data-testid="journey-timeline">
    <div class="rule mb-16"></div>
    {journey.map((role) => (
      <article class="mb-16 md:mb-20 grid grid-cols-1 md:grid-cols-5 gap-4 md:gap-10">
        <div class="md:col-span-1">
          <div class="meta" data-testid="role-dates">{formatDate(role.start)} — {formatDate(role.end)}</div>
          <div class="meta opacity-70 mt-1">{role.location}</div>
        </div>
        <div class="md:col-span-4 max-w-prose">
          <h3 class="font-serif text-2xl md:text-3xl font-medium leading-tight" data-testid="role-company">
            {role.company}
          </h3>
          <p class="meta mt-1" data-testid="role-title">{role.role}</p>
          <p class="mt-4 text-base leading-relaxed" data-testid="role-summary">{role.summary}</p>
          {role.nda && (
            <p class="meta mt-3 italic opacity-70">
              Under NDA on the specifics — <a href="https://linkedin.com/in/achint-satsangi">LinkedIn</a> has what I can talk about publicly.
            </p>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="page pt-8" data-testid="recommendations">
    <div class="rule mb-16"></div>
    <p class="meta mb-2">In their words</p>
    <h2 class="font-serif text-3xl md:text-4xl font-medium mb-12 max-w-prose">
      Five people who worked with me, in five different rooms.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
      {recommendations.map((r) => (
        <blockquote class="border-l-2 border-rust dark:border-rust-dark pl-6" data-testid={`rec-${r.name.split(' ')[0].toLowerCase()}`}>
          <p class="font-serif text-lg leading-relaxed italic mb-4">"{r.quote}"</p>
          <footer class="meta">
            <span class="text-ink dark:text-ink-dark font-medium">{r.name}</span>
            <span class="opacity-70"> · {r.role}, {r.company}</span>
            <span class="opacity-50"> · {formatRecDate(r.date)}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>
</Layout>
