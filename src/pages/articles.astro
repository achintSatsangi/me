---
import Layout from '../layouts/Layout.astro';
import articles from '../data/articles.json';

const [featured, ...rest] = articles;
function fmt(iso: string): string {
  if (!iso) return '';
  const d = new Date(iso);
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Layout title="Articles — Achint Satsangi">
  <section class="page hero">
    <p class="meta mb-6">Published in ThePrint</p>
    <h1 class="display-lg max-w-5xl" data-testid="articles-hero">
      I write for ThePrint on Indian politics, policy, and identity.
    </h1>
    <p class="mt-10 body-lg max-w-3xl text-muted dark:text-muted-dark">
      A different register from LinkedIn — longer, quieter, more argument.
      <a href="https://theprint.in/author/achint-satsangi/">ThePrint</a> is one of India's larger
      independent digital newsrooms; four pieces published so far, more when the argument
      is ready.
    </p>
  </section>

  {featured && (
    <section class="page section" data-testid="articles-featured">
      <p class="meta mb-6">Latest</p>
      <a href={featured.link} target="_blank" rel="noopener noreferrer" class="block group max-w-5xl">
        <h2 class="display-md group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
          {featured.title}
        </h2>
        <p class="meta mt-6">{fmt(featured.date)} · Read on ThePrint →</p>
        {featured.excerpt && (
          <p class="mt-10 body-lg text-muted dark:text-muted-dark max-w-prose">
            {featured.excerpt}
          </p>
        )}
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="page section border-t border-rule dark:border-rule-dark" data-testid="articles-list">
      <p class="meta mb-10">Earlier</p>
      <div class="space-y-16 max-w-5xl">
        {rest.map((a) => (
          <article data-testid="article-item">
            <a href={a.link} target="_blank" rel="noopener noreferrer" class="block group">
              <h3 class="display-md group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
                {a.title}
              </h3>
              <p class="meta mt-4">{fmt(a.date)} · ThePrint →</p>
              {a.excerpt && (
                <p class="mt-5 body-lg text-muted dark:text-muted-dark max-w-prose">{a.excerpt}</p>
              )}
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {articles.length === 0 && (
    <section class="page section">
      <p class="meta italic opacity-60" data-testid="articles-empty">
        Article list will land here — refresh the data script or read directly on
        <a href="https://theprint.in/author/achint-satsangi/">theprint.in</a>.
      </p>
    </section>
  )}
</Layout>
