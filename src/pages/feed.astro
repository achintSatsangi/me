---
import Layout from '../layouts/Layout.astro';
import LinkedInFeed from '../components/LinkedInFeed.jsx';
import posts from '../data/linkedin-posts.json';
import postImages from '../data/post-images.json';
import sharp from 'sharp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
async function withDimensions(file: string, alt: string) {
  const { width, height } = await sharp(`public/images/feed/${file}`).metadata();
  return { src: `${base}/images/feed/${file}`, alt, width, height };
}

const withImages = await Promise.all(posts.map(async (p) => {
  const entry = postImages[p.link];
  if (!entry) return p;
  const media = await Promise.all(
    (entry.images || [{ file: entry.file, alt: entry.alt }])
      .filter((m) => m.file)
      .map((m) => withDimensions(m.file, m.alt || '')),
  );
  const next = { ...p };
  if (media.length) next.images = media;
  if (entry.article) next.article = entry.article;
  return next;
}));
---
<Layout title="Feed - Achint Satsangi" description="I share what I learn on LinkedIn every week. All of it in one place, newest first, with no algorithm deciding what you see.">
  <section class="page hero-inner pt-8 pb-6 md:py-32">
    <p class="meta mb-3 md:mb-6">The LinkedIn side</p>
    <h1 class="display-lg max-w-5xl" data-testid="feed-hero">
      What I've been writing, in the shorter, sharper voice.
    </h1>
    <p class="mt-4 md:mt-10 text-base md:text-xl leading-[1.55] max-w-3xl text-muted dark:text-muted-dark">
      I share what I learn on LinkedIn every week. All of it in one place, newest first, with no algorithm deciding what you see.
    </p>
    <p class="meta mt-4 md:mt-8 text-muted dark:text-muted-dark">
      {posts.length} posts ·
      <a href="https://linkedin.com/in/achint-satsangi/recent-activity/all/">See on LinkedIn →</a>
    </p>
  </section>

  <section class="page section pt-2 md:pt-32">
    <LinkedInFeed posts={withImages} client:idle />
  </section>
</Layout>
