---
import Layout from '../layouts/Layout.astro';
import LinkedInFeed from '../components/LinkedInFeed.jsx';
import posts from '../data/linkedin-posts.json';
---
<Layout title="Feed — Achint Satsangi">
  <section class="page hero-inner">
    <p class="meta mb-6">The LinkedIn side</p>
    <h1 class="display-lg max-w-5xl" data-testid="feed-hero">
      What I've been writing, in the shorter, sharper voice.
    </h1>
    <p class="mt-10 body-lg max-w-3xl text-muted dark:text-muted-dark">
      Two posts a week on AI, engineering, and career. This page is the archive — every post
      I've published, searchable, no algorithm deciding what you see. LinkedIn shows you what it
      wants you to read; this shows you what I actually wrote.
    </p>
    <p class="meta mt-8 text-muted dark:text-muted-dark">
      {posts.length} posts · Cadence: 2 posts / week ·
      <a href="https://linkedin.com/in/achint-satsangi/recent-activity/all/">See on LinkedIn →</a>
    </p>
  </section>

  <section class="page section">
    <LinkedInFeed posts={posts} client:load />
  </section>
</Layout>
