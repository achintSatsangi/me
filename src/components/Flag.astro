---
const { country } = Astro.props;
---
<svg width="20" height="14" viewBox="0 0 30 20" preserveAspectRatio="none" aria-hidden="true" class="mr-1.5 inline-block shrink-0 rounded-[2px] ring-1 ring-black/15 dark:ring-white/25 align-[-1px]">
  {country === 'india' && (<>
    <rect width="30" height="20" fill="#fff"/>
    <rect width="30" height="6.67" fill="#FF9933"/>
    <rect y="13.33" width="30" height="6.67" fill="#138808"/>
    <circle cx="15" cy="10" r="2.6" fill="none" stroke="#000080" stroke-width="0.8"/>
  </>)}
  {country === 'south-africa' && (<>
    <rect width="30" height="10" fill="#DE3831"/>
    <rect y="10" width="30" height="10" fill="#002395"/>
    <path d="M0 0 12 10 0 20M12 10H30" fill="none" stroke="#fff" stroke-width="7"/>
    <path d="M0 0 12 10 0 20M12 10H30" fill="none" stroke="#007749" stroke-width="4"/>
    <path d="M0 2.5V17.5L8.5 10z" fill="#FFB612"/>
    <path d="M0 4.5V15.5L6.2 10z" fill="#000"/>
  </>)}
  {country === 'norway' && (<>
    <rect width="30" height="20" fill="#BA0C2F"/>
    <path d="M10 0V20M0 10H30" stroke="#fff" stroke-width="5"/>
    <path d="M10 0V20M0 10H30" stroke="#00205B" stroke-width="2.4"/>
  </>)}
</svg>
