---
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/journey/`, label: 'Journey', match: (p: string) => p.startsWith(`${base}/journey`) },
  { href: `${base}/feed/`, label: 'Feed', match: (p: string) => p.startsWith(`${base}/feed`) },
  { href: `${base}/articles/`, label: 'Articles', match: (p: string) => p.startsWith(`${base}/articles`) },
];
---
<nav class="sticky top-0 z-50 backdrop-blur-md bg-paper/80 dark:bg-paper-dark/80 border-b border-rule/60 dark:border-rule-dark/60">
  <div class="max-w-editorial mx-auto px-4 md:px-10 py-1 md:py-4 flex flex-wrap items-center justify-between gap-x-4">
    <a href={`${base}/`} data-testid="nav-name" class="font-display text-base md:text-lg font-semibold tracking-tighter text-ink dark:text-ink-dark">
      <span class="md:hidden">Achint</span><span class="hidden md:inline">Achint&nbsp;Satsangi</span>
    </a>
    <div class="flex items-center gap-3 md:gap-12 text-sm md:text-base">
      {links.map((l) => (
        <a href={l.href} class={`nav-link inline-flex items-center min-h-11 md:min-h-0 md:py-2 md:-my-2 ${l.match(pathname) ? 'active' : ''}`} aria-current={l.match(pathname) ? 'page' : undefined} data-testid={`nav-${l.label.toLowerCase()}`}>
          {l.label}
        </a>
      ))}
      <button
        id="theme-toggle"
        class="inline-flex items-center justify-center gap-2 min-h-11 min-w-9 md:min-h-0 md:py-2 md:px-4 md:-my-2 rounded-full md:border border-rule dark:border-rule-dark text-sm font-medium text-ink dark:text-ink-dark hover:border-ink dark:hover:border-ink-dark transition-colors"
        data-testid="theme-toggle"
      >
        <span class="inline-flex items-center gap-2 dark:hidden">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <span class="sr-only md:not-sr-only">Turn off the lights</span>
        </span>
        <span class="hidden dark:inline-flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2h5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3z"/></svg>
          <span class="sr-only md:not-sr-only">Turn on the lights</span>
        </span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });
</script>
