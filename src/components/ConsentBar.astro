---
import { GA_MEASUREMENT_ID } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{GA_MEASUREMENT_ID && (
  <>
    <section
      id="consent-bar"
      data-testid="consent-bar"
      aria-label="Analytics consent"
      hidden
      class="fixed inset-x-0 bottom-0 z-50 border-t border-rule dark:border-rule-dark bg-paper dark:bg-[#1A1A1D] text-ink dark:text-ink-dark shadow-[0_-4px_16px_rgba(0,0,0,0.12)] pb-[env(safe-area-inset-bottom)]"
    >
      <div class="mx-auto max-w-3xl px-4 py-3 flex flex-col sm:flex-row sm:items-center gap-3">
        <p id="consent-body" class="text-sm leading-snug flex-1">
          <strong id="consent-title" class="font-semibold">Can I count your visit?</strong>
          A Google Analytics cookie shows which pages get read. No ads, nothing sold.
          <a href={`${base}/privacy/`} class="text-accent dark:text-accent-dark underline">Details</a>
        </p>
        <div class="grid grid-cols-2 gap-2 sm:w-auto">
          <button type="button" class="pill justify-center min-h-11 py-2 px-5" data-consent="granted" data-testid="consent-yes">Count me in</button>
          <button type="button" class="pill justify-center min-h-11 py-2 px-5" data-consent="denied" data-testid="consent-no">No thanks</button>
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        const CONSENT_KEY = 'analytics-consent';
        const bar = document.getElementById('consent-bar');
        const reservePageBottom = function () { document.body.style.paddingBottom = bar.hidden ? '' : bar.offsetHeight + 'px'; };
        const choose = function (choice) {
          localStorage.setItem(CONSENT_KEY, choice);
          bar.hidden = true;
          reservePageBottom();
          if (choice === 'granted') window.loadAnalytics();
          document.dispatchEvent(new Event('analytics-consent-changed'));
        };
        window.openConsentBar = function () {
          if (!bar.hidden) return;
          bar.hidden = false;
          reservePageBottom();
        };
        window.addEventListener('resize', reservePageBottom);
        if (!localStorage.getItem(CONSENT_KEY)) window.openConsentBar();
        bar.addEventListener('click', function (e) {
          const choice = e.target.closest('[data-consent]')?.dataset.consent;
          if (choice) choose(choice);
        });
      })();
    </script>
  </>
)}
