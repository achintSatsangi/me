---
import { GA_MEASUREMENT_ID } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{GA_MEASUREMENT_ID && (
  <>
    <dialog
      id="consent-bar"
      data-testid="consent-bar"
      aria-labelledby="consent-title"
      aria-describedby="consent-body"
      class="w-[calc(100%-2rem)] max-w-md rounded-2xl border border-rule dark:border-rule-dark bg-paper dark:bg-[#1A1A1D] text-ink dark:text-ink-dark p-6 md:p-8 shadow-2xl backdrop:bg-black/50"
    >
      <h2 id="consent-title" tabindex="-1" class="font-display text-2xl font-semibold tracking-tight focus:outline-none">Can I count your visit?</h2>
      <div id="consent-body" class="mt-4 space-y-3 text-base leading-[1.55] text-muted dark:text-muted-dark">
        <p>This is a one-person site. A Google Analytics cookie tells me which pages people read and what they click, so I know what's worth writing more of.</p>
        <p>That's all it's for. Google processes it on my behalf. No ads, nothing sold.</p>
      </div>
      <p class="mt-3 text-base"><a href={`${base}/privacy/`} class="text-accent dark:text-accent-dark">Details</a></p>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <button type="button" class="pill justify-center py-3.5" data-consent="granted" data-testid="consent-yes">Count me in</button>
        <button type="button" class="pill justify-center py-3.5" data-consent="denied" data-testid="consent-no">No thanks</button>
      </div>
    </dialog>
    <script is:inline>
      (function () {
        const CONSENT_KEY = 'analytics-consent';
        const dialog = document.getElementById('consent-bar');
        const choose = function (choice) {
          localStorage.setItem(CONSENT_KEY, choice);
          dialog.close();
          if (choice === 'granted') window.loadAnalytics();
          document.dispatchEvent(new Event('analytics-consent-changed'));
        };
        window.openConsentDialog = function () {
          if (dialog.open) return;
          dialog.showModal();
          document.getElementById('consent-title').focus();
        };
        if (!localStorage.getItem(CONSENT_KEY)) window.openConsentDialog();
        dialog.addEventListener('cancel', function (e) { e.preventDefault(); choose('denied'); });
        dialog.addEventListener('click', function (e) {
          const choice = e.target.closest('[data-consent]')?.dataset.consent;
          if (choice) choose(choice);
        });
      })();
    </script>
  </>
)}
